{
  "name": "reelform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reelform — desktop screen recorder + demo-video editor",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "icons": "node scripts/generate-icons.mjs",
    "sounds": "node scripts/generate-click-sounds.mjs",
    "cursors": "node scripts/generate-cursor-packs.mjs",
    "assets": "npm run icons && npm run sounds && npm run cursors",
    "native:build": "node scripts/build-native-helpers.mjs",
    "whisper:build": "node scripts/build-whisper-runtime.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "electron-updater": "^6.8.9",
    "immer": "^10.1.1",
    "mediabunny": "^1.56.2",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
